* text=auto

# Keep shell/Python/Markdown/JSON with LF in the repository
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf

# Keep Windows batch scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit text/diff handling for review-friendly PRs
*.md text diff
*.json text diff
